# Copy to .env for local development. Never commit a real .env, and never put secrets in code.
# In Azure, set these as App Service application settings; keep secrets in Key Vault references.

# --- Storage (leave AUDIT_CONNECTION_STRING unset locally to use SQLite) ---
# AUDIT_CONNECTION_STRING=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/audit-conn/)
AUDIT_DB_PATH=civicsignal_data.sqlite3
TENANT_ID=default

# --- Scope: comma-separated county names, or ALL. Unset = Chicago-area seven counties ---
# ALLOWED_COUNTIES=Cook,DuPage,Kane,Kendall,Lake,McHenry,Will

# --- Roles (emails, comma-separated). Token app roles are also honoured behind Easy Auth ---
# ROLE_ADMINS=admin@example.org
# ROLE_OFFICIALS=official@example.org
# ROLE_REVIEWERS=reviewer@example.org

# --- Local development sign-in ONLY. Never set these in production ---
# ALLOWED_EMAILS=you@example.org
# DEV_USER_EMAIL=you@example.org

# --- Behind Azure Easy Auth, App Service sets WEBSITE_AUTH_ENABLED=True itself. Otherwise only if you front the app with a trusted proxy ---
# TRUST_AUTH_HEADERS=1

# --- Optional monitoring (Azure Application Insights) ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
